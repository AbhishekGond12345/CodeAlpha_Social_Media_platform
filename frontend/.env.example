# ───────────────────────────────────────────────────────────────
#  COBBLE FRONTEND — only PUBLIC values go here (they are visible in the browser).
#  Do NOT put the Supabase service-role key or any secret in this file.
# ───────────────────────────────────────────────────────────────

# URL of the backend API (include /api). Change to your deployed backend URL in production.
VITE_API_URL=http://localhost:5000/api

# true  = UI preview with sample data, no backend needed (log in with any email/password)
# false = use the real backend
VITE_DEMO_MODE=true

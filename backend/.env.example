# ───────────────────────────────────────────────────────────────
#  COBBLE BACKEND — put your real values here, then save.
#  Never commit this file (it is listed in .gitignore).
# ───────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# URL where the React app runs (used for CORS). Add your deployed URL later.
CLIENT_URL=http://localhost:5173

# MongoDB  (Atlas: Connect → Drivers → copy the connection string)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cobble?retryWrites=true&w=majority
MONGODB_URI=

# Supabase  (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET — server only. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for photos/videos (created by supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=media

# Session tokens issued by this API
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
